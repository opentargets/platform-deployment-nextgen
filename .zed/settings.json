{
  "languages": {
    "YAML": {
      "format_on_save": "on",
      "formatter": "language_server",
    },
  },
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "format": {
            "singleQuote": true,
            "printWidth": 120,
          },
          "schemas": {
            "./helm/platform/values.schema.json": [
              "helm/platform/values.yaml",
              "profiles/{local,devcluster,production}/{platform,ppp}/{blue,green}.yaml",
            ],
            "./helm/observability/values.schema.json": [
              "helm/observability/values.yaml",
              "profiles/{local,devcluster,production}/observability.yaml",
            ],
            "./helm/router/values.schema.json": [
              "helm/router/values.yaml",
              "profiles/{local,devcluster,production}/{platform,ppp}/router.yaml"
            ]
          },
        },
      },
    },
  },
}
